# Copy to .env. Everything here is optional for local use.

PORT=8787

# The address this server is reached at from outside. Used as the OAuth issuer and in the metadata.
# On Render it is taken from RENDER_EXTERNAL_URL. Set it yourself behind a custom domain.
# PUBLIC_URL=https://recall-check.example

# Who may call POST /mcp.
#   token (default): an OAuth access token, a token listed in ACCESS_TOKENS as token:household pairs,
#     or one the simulator signed for a browser
#   open: no token, every caller shares the DEMO_USER household. Local use only.
AUTH_MODE=token
ACCESS_TOKENS=
# DEMO_USER=demo

# Authentication for Alexa+ (src/oauth.ts). The client is the one registered with alexa-ai configure-account-linking.
# List every redirect address Amazon shows, separated by commas.
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_REDIRECT_URIS=
# Signs codes and access tokens. Set it in production, or a restart signs everyone out.
# OAUTH_SECRET=

# Where households and accounts are kept. Redis over REST (Upstash) when both are set, files otherwise.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# The simulated Alexa+ page at /. Set to off to serve only the MCP endpoint.
SIMULATOR=on
# Signs the simulator's per-browser household tokens. Set it in production so tokens survive a restart.
# SIM_SECRET=

# Optional language model for the simulator (any OpenAI-compatible endpoint with tool calling).
# Without these the simulator understands utterances with built-in rules.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=

# Recall data
# RECALL_DATA=data/recalls.json.gz
# RECALL_SINCE=2016-01-01
# RECALL_REFRESH_HOURS=6
# HOUSEHOLD_DIR=data/households
