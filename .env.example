# Copy to .env. Everything here is optional for local use.

PORT=8787

# Who may call POST /mcp.
#   token (default): bearer tokens listed in ACCESS_TOKENS as token:household pairs
#   open: no token, every caller shares the DEMO_USER household. Local use only.
AUTH_MODE=token
ACCESS_TOKENS=
# DEMO_USER=demo

# The simulated Alexa+ page at /. Set to off to serve only the MCP endpoint.
SIMULATOR=on
# Signs the simulator's per-browser household tokens. Set it in production so tokens survive a restart.
# SIM_SECRET=

# Optional language model for the simulator (any OpenAI-compatible endpoint with tool calling).
# Without these the simulator understands utterances with built-in rules.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=

# Recall data
# RECALL_DATA=data/recalls.json.gz
# RECALL_SINCE=2016-01-01
# RECALL_REFRESH_HOURS=6
# HOUSEHOLD_DIR=data/households
