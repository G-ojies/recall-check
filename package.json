{
  "name": "recall-check",
  "version": "0.1.0",
  "private": true,
  "description": "Tell Alexa what you own. Recall Check tells you when any of it is recalled.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/serve.ts",
    "start": "tsx src/serve.ts",
    "sync": "tsx scripts/sync.ts",
