    "test": "tsx --test tests/*.test.ts",
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "express": "^4.21.2",
    "tsx": "^4.19.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.6.2"
  }
}
